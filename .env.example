# ===== NASA FIRMS =====
# Chave gratuita: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
FIRMS_SOURCE=VIIRS_NOAA20_NRT
# area -> usa FIRMS_BBOX (west,south,east,north) | country -> endpoint descontinuado pela NASA
FIRMS_QUERY_MODE=area
FIRMS_COUNTRY=BRA
# Exemplo Brasil: -74.0,-34.0,-34.7,5.3
FIRMS_BBOX=-74.0,-34.0,-34.7,5.3
# Dias retroativos (1 a 5)
FIRMS_DAY_RANGE=1
FIRMS_TIMEOUT_SECONDS=60
FIRMS_MAX_RETRIES=3

# ===== Regras de risco (FRP em MW) =====
# Baixo < 10 <= Médio < 50 <= Alto < 100 <= Crítico
RISK_MEDIO_FRP=10
RISK_ALTO_FRP=50
RISK_CRITICO_FRP=100
# Nível mínimo que dispara alerta: BAIXO | MEDIO | ALTO | CRITICO
ALERT_MIN_LEVEL=CRITICO

# ===== Filtros de foco ativo =====
# Confiança mínima para sensores com valor numérico (MODIS). VIIRS descarta "l" (low).
MIN_NUMERIC_CONFIDENCE=30
MIN_FRP=0

# ===== Saída =====
OUTPUT_CSV=data/ocorrencias.csv
CSV_DELIMITER=,
LOG_FILE=logs/firms_monitor.log
LOG_LEVEL=INFO
